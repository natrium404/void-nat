# Template file for 'helium-browser-bin'
pkgname=helium-browser-bin
version=0.18.2.1
revision=1
archs="x86_64"
create_wrksrc=yes
short_desc="Privacy-first browser without distractions based on Chromium"
maintainer="Natrium <heynatrium@proton.me>"
license="GPL-3.0-only AND BSD-3-Clause"
homepage="https://helium.computer/"
changelog="https://github.com/imputnet/helium-linux/releases"
distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64_linux.tar.xz"
checksum=4493d756b98afbe3fd7d45c0ec215c23f5a0551fae715586fe6ce3b2298b155c
provides="helium-browser-${version}_${revision}"
conflicts="helium-browser helium"
nopie=yes
nostrip=yes

do_install() {
	vmkdir opt/helium
	vcopy "helium-${version}-x86_64_linux/*" opt/helium

	rm -f ${DESTDIR}/opt/helium/locales/*_*.pak

	chmod 0755 ${DESTDIR}/opt/helium/helium \
		${DESTDIR}/opt/helium/helium-wrapper \
		${DESTDIR}/opt/helium/chrome \
		${DESTDIR}/opt/helium/chromedriver \
		${DESTDIR}/opt/helium/helium_crashpad_handler \
		${DESTDIR}/opt/helium/*.so*

	vmkdir usr/bin
	ln -sf /opt/helium/helium-wrapper ${DESTDIR}/usr/bin/helium

	vinstall ${DESTDIR}/opt/helium/helium.desktop 644 usr/share/applications
	vinstall ${DESTDIR}/opt/helium/product_logo_256.png 644 usr/share/pixmaps helium.png

	vsed -i ${DESTDIR}/usr/share/applications/helium.desktop \
		-e 's|^Exec=.*|Exec=/usr/bin/helium %U|'

	if [ -f "helium-${version}-x86_64_linux/LICENSE" ]; then
		vlicense "helium-${version}-x86_64_linux/LICENSE"
	fi
}
