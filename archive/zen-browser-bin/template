# Template file for 'zen-browser-bin'
pkgname=zen-browser-bin
version=1.22.3b
revision=1
archs="x86_64"
short_desc="Firefox-based browser focused on productivity, privacy, calmer internet"
maintainer="Natrium <heynatrium@proton.me>"
license="MPL-2.0"
homepage="https://zen-browser.app"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen.linux-x86_64.tar.xz"
checksum=0aaee1b3f67f074aebf7fc6c2fe824441bcafd431e9991336479c16370519dd0
conflicts="zen-browser"
provides="zen-browser-${version}_${revision}"

nopie=yes
nostrip=yes

do_install() {
	vmkdir opt/zen-browser
	vcopy * opt/zen-browser

	vmkdir usr/bin
	ln -sf /opt/zen-browser/zen "${DESTDIR}/usr/bin/zen-browser"

	vmkdir usr/share/applications
	vmkdir usr/share/pixmaps

	vinstall browser/chrome/icons/default/default128.png 644 usr/share/pixmaps zen-browser.png

	cat <<-'EOF' > "${DESTDIR}/usr/share/applications/zen-browser.desktop"
		[Desktop Entry]
		Name=Zen Browser
		Comment=Experience tranquility while browsing the web
		Exec=zen-browser %u
		Icon=zen-browser
		Terminal=false
		Type=Application
		Categories=Network;WebBrowser;
		MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
	EOF

	if [ -f LICENSE ]; then
		vlicense LICENSE
	fi
}
